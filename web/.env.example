# Copy to web/.env. The deploy script writes these automatically after
# `npm run deploy:sepolia` in ../contracts.
VITE_TEST_USD_ADDRESS=
VITE_CONFIDENTIAL_USD_ADDRESS=
VITE_PRIZE_POOL_ADDRESS=

# Optional. Falls back to the public Sepolia RPC, which is rate-limited.
VITE_SEPOLIA_RPC_URL=

# Optional. Needed only for WalletConnect-based wallets; injected wallets
# (MetaMask, Rabby) work without it.
VITE_WALLETCONNECT_PROJECT_ID=
